{
  "name": "fonseca-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:export": "expo export --platform web --clear && node scripts/copy-pwa-assets.mjs",
    "web:deploy": "npm run web:deploy:prod",
    "web:deploy:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-web.ps1 -Environment dev",
    "web:deploy:prod": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-web.ps1 -Environment prod",
    "web:promote:prod": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/promote-to-prod.ps1",
    "supabase:dev:migrate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-supabase-dev.ps1 -ApplyMigrations",
    "supabase:dev:clone": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-supabase-dev.ps1 -CloneData",
    "supabase:dev:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-supabase-dev.ps1 -ApplyMigrations -CloneData",
    "supabase:dev:seed": "node scripts/seed-dev-test-data.mjs",
    "web:preview": "npx serve dist",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "build:android": "eas build --profile production --platform android",
    "build:preview": "eas build --profile preview --platform android",
    "keepalive:deploy": "npx wrangler deploy workers/keep-alive.js --config workers/wrangler-keepalive.toml",
    "keepalive:secrets": "npx wrangler secret put SUPABASE_URL --config workers/wrangler-keepalive.toml && npx wrangler secret put SUPABASE_ANON_KEY --config workers/wrangler-keepalive.toml",
    "keepalive:test": "npx wrangler dev workers/keep-alive.js --config workers/wrangler-keepalive.toml"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "^8.4.4",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "@supabase/supabase-js": "^2.105.3",
    "@tanstack/react-query": "^5.100.9",
    "date-fns": "^4.1.0",
    "expo": "~54.0.33",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-document-picker": "^14.0.8",
    "expo-file-system": "^19.0.22",
    "expo-font": "^14.0.11",
    "expo-image-picker": "^17.0.11",
    "expo-linking": "~8.0.12",
    "expo-network": "^8.0.8",
    "expo-notifications": "^0.32.17",
    "expo-print": "~15.0.8",
    "expo-router": "^6.0.23",
    "expo-secure-store": "^15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "^31.0.13",
    "expo-sqlite": "^16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-gifted-charts": "^1.4.76",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "^5.6.0",
    "react-native-screens": "^4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "^0.5.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "expo-doctor": "^1.18.22",
    "typescript": "~5.9.2"
  },
  "private": true
}
