# Arquivos com hash no nome: imutáveis, cache longo
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  Content-Type: font/ttf

# Service worker e HTML: nunca cacheados (precisam ser sempre frescos)
/sw.js
  Cache-Control: no-store, no-cache, must-revalidate
  Pragma: no-cache

/index.html
  Cache-Control: no-store, no-cache, must-revalidate
  Pragma: no-cache

# Manifest e ícones: revalida sempre
/manifest.webmanifest
  Cache-Control: no-cache

/*.png
  Cache-Control: no-cache

# Tudo mais: revalida
/*
  Cache-Control: no-cache
