{
  "expo": {
    "name": "GSF - Gerenciamento de Clubes DBV/AVT",
    "slug": "fonseca-app",
    "version": "1.0.19",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "dbvfonseca",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a3a5c"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.slowdev.gsfdbv",
      "buildNumber": "4",
      "infoPlist": {
        "NSCameraUsageDescription": "Usado para tirar a foto de perfil dos membros/responsáveis e para anexar fotos de documentos (RG, CPF, comprovantes etc).",
        "NSPhotoLibraryUsageDescription": "Usado para escolher, na galeria, a foto de perfil dos membros/responsáveis e os anexos de documentos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.slowdev.gsfdbv",
      "googleServicesFile": "./google-services.json",
      "versionCode": 29,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1a3a5c",
          "sounds": []
        }
      ],
      "./plugins/withReleaseSigning.js"
    ],
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "GSF - Gerenciamento de Clubes DBV/AVT",
      "shortName": "GSF Clubes",
      "themeColor": "#1a3a5c",
      "backgroundColor": "#1a3a5c"
    },
    "extra": {
      "eas": {
        "projectId": "9a17e33e-5b60-414f-9e3b-bc71dc824298"
      }
    },
    "owner": "slowonedev2"
  }
}
