{
  "expo": {
    "name": "DBV+",
    "slug": "fonseca-app",
    "version": "1.0.24",
    "orientation": "portrait",
    "icon": "./assets/favicon.png",
    "scheme": "dbvfonseca",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo-transparente.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a3a5c"
    },
    "ios": {
      "icon": "./assets/icon-ios.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.slowdev.gsfdbv",
      "buildNumber": "7",
      "infoPlist": {
        "NSCameraUsageDescription": "Usado para tirar a foto de perfil dos membros/responsáveis e para anexar fotos de documentos (RG, CPF, comprovantes etc).",
        "NSPhotoLibraryUsageDescription": "Usado para escolher, na galeria, a foto de perfil dos membros/responsáveis e os anexos de documentos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-android-foreground.png",
        "backgroundColor": "#1a3a5c"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "package": "com.slowdev.gsfdbv",
      "googleServicesFile": "./google-services.json",
      "versionCode": 144,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usado para entrar no DBV+ com o rosto, sem digitar a senha."
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1a3a5c",
          "sounds": []
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class expo.modules.sqlite.** { *; }\n-keep class com.google.android.play.core.** { *; }\n-dontwarn com.google.android.play.core.**"
          }
        }
      ],
      "./plugins/withReleaseSigning.js"
    ],
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "DBV+",
      "shortName": "DBV+",
      "themeColor": "#1a3a5c",
      "backgroundColor": "#1a3a5c"
    },
    "extra": {
      "eas": {
        "projectId": "9a17e33e-5b60-414f-9e3b-bc71dc824298"
      }
    },
    "owner": "slowonedev2"
  }
}
